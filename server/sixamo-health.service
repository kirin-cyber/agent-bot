[Unit]
Description=Sixamo API Server (Webhook + Health Check)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/sixamo
ExecStart=/usr/bin/python3 /opt/sixamo/health_app.py
Restart=always
RestartSec=5
Environment=HEALTH_HOST=127.0.0.1
Environment=HEALTH_PORT=5000
EnvironmentFile=-/opt/sixamo/.env

[Install]
WantedBy=multi-user.target
