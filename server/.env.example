# Sixamo API Server 環境変数
# このファイルを /opt/sixamo/.env にコピーして値を設定してください
# セットアップ: sudo bash setup-zendesk-webhook.sh

# --- Zendesk ---
# サブドメイン（https://sixamo.zendesk.com の場合は "sixamo"）
ZENDESK_SUBDOMAIN=sixamo

# Zendesk管理画面 → Webhook → 署名シークレット から取得
# 手順: https://sixamo.zendesk.com/admin → オブジェクトとルール → Webhook → 作成 → 署名シークレット有効化
ZENDESK_WEBHOOK_SECRET=your_webhook_signing_secret_here

# ZendeskのIPレンジ（カンマ区切りCIDR）
# 自動取得: curl https://sixamo.zendesk.com/ips
# 手動設定: Zendesk統合レンジ 216.198.0.0/18
# setup-zendesk-webhook.sh で自動更新されます
ZENDESK_IP_RANGES=216.198.0.0/18

# --- Telegram 通知 ---
# @kirin76supportbot のトークン
TELEGRAM_BOT_TOKEN=8584264439:AAEXAgDVG_Mgg4X8hlch0aTSwXCinNp1RlI

# 通知先チャットID（グループの場合は負の数）
# 取得方法:
#   1. Telegramで @kirin76supportbot に /start を送信
#   2. ブラウザで https://api.telegram.org/bot<TOKEN>/getUpdates にアクセス
#   3. "chat":{"id":XXXXXXX} の数値をここに設定
TELEGRAM_CHAT_ID=6976979859

# --- Zendesk API 認証（Telegram → Zendesk 返信用） ---
# 管理画面 → 設定 → API → トークンアクセス有効化 → APIトークン生成
ZENDESK_EMAIL=support@sixamo.com
ZENDESK_API_TOKEN=your_zendesk_api_token_here

# --- Telegram 管理者 ---
# Telegram からの返信操作を許可する Chat ID（管理者のみ）
# 取得: Bot に /start → getUpdates で from.id を確認
ADMIN_CHAT_ID=6976979859

# --- 動作モード ---
# true: 自動返信を送信せずTelegramにプレビューのみ通知
# false: 通常モード（自動返信を実行）
DRYRUN_MODE=true

# --- ログ ---
# ログファイルの出力先ディレクトリ (access.log, error.log)
LOG_DIR=/opt/sixamo
