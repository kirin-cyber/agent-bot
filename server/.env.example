# Sixamo API Server 環境変数
# このファイルを /opt/sixamo/.env にコピーして値を設定してください
# セットアップ: sudo bash setup-zendesk-webhook.sh

# --- Zendesk ---
# サブドメイン（https://sixamo.zendesk.com の場合は "sixamo"）
ZENDESK_SUBDOMAIN=sixamo

# Zendesk管理画面 → Webhook → 署名シークレット から取得
# 手順: https://sixamo.zendesk.com/admin → オブジェクトとルール → Webhook → 作成 → 署名シークレット有効化
ZENDESK_WEBHOOK_SECRET=your_webhook_signing_secret_here

# ZendeskのIPレンジ（カンマ区切りCIDR）
# 自動取得: curl https://sixamo.zendesk.com/ips
# 手動設定: Zendesk統合レンジ 216.198.0.0/18
# setup-zendesk-webhook.sh で自動更新されます
ZENDESK_IP_RANGES=216.198.0.0/18

# --- Telegram 通知 ---
# @BotFather で作成したBotのトークン
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# 通知先チャットID（グループの場合は負の数）
# @userinfobot にメッセージを送って確認
TELEGRAM_CHAT_ID=123456789

# --- 動作モード ---
# true: 自動返信を送信せずTelegramにプレビューのみ通知
# false: 通常モード（自動返信を実行）
DRYRUN_MODE=true

# --- ログ ---
# ログファイルの出力先ディレクトリ (access.log, error.log)
LOG_DIR=/opt/sixamo
