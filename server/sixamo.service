[Unit]
Description=Sixamo API Server (gunicorn + main.py)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/sixamo
EnvironmentFile=-/opt/sixamo/.env
Environment=GUNICORN_WORKERS=2
ExecStart=/opt/sixamo/venv/bin/gunicorn main:app \
    --bind 127.0.0.1:5000 \
    --workers 2 \
    --timeout 60 \
    --access-logfile /opt/sixamo/access.log \
    --error-logfile /opt/sixamo/error.log
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
