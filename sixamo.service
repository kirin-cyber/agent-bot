[Unit]
Description=Sixamo Zendesk Automation Server
After=network.target

[Service]
Type=notify
User=www-data
Group=www-data
WorkingDirectory=/opt/sixamo
Environment="PATH=/opt/sixamo/venv/bin:/usr/bin"
EnvironmentFile=/opt/sixamo/.env
ExecStart=/opt/sixamo/venv/bin/gunicorn \
    --bind 127.0.0.1:5000 \
    --timeout 60 \
    --workers ${GUNICORN_WORKERS} \
    main:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
